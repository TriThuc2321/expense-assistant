APP_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/expense

# Auth (better-auth) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# comma-separated, case-insensitive
ALLOWED_EMAILS=

# The one Sổ Chi bot (Zalo Bot Creator) — its token
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=

# Claude API
ANTHROPIC_API_KEY=

# Cloudflare R2 (receipt images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Protects /api/cron/* — generate with: openssl rand -hex 32
CRON_SECRET=

# Dev only: your ngrok static domain, e.g. xxx.ngrok-free.app
DEV_TUNNEL_HOST=
